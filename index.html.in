<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f4f1e9">
<title>百人一首 · 百人一首学习手帖</title>
<style>
@font-face{font-family:"Shippori Mincho";font-weight:500;font-style:normal;font-display:swap;src:url(data:font/ttf;base64,__FONT_BASE64__) format("truetype")}

:root{--paper:#f4f1e9;--surface:#fffdf7;--ink:#29342e;--muted:#626b61;--line:#d8dace;--green:#344e40;--soft:#e7ebdf;--red:#944b3b;--redsoft:#f5e8df;--focus:#265baa;--serif:"Shippori Mincho","Yu Mincho","Hiragino Mincho ProN","Songti SC","Noto Serif CJK SC",serif;--sans:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans",sans-serif}
*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--paper);font:15px/1.65 var(--sans)}button,input,select{font:inherit;color:inherit}button,a,select{touch-action:manipulation}button{cursor:pointer}button:disabled{cursor:default;opacity:.55}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--focus);outline-offset:4px}button{border:0}a{color:var(--green);text-underline-offset:4px}h1,h2,h3,p{margin:0}h1{font:500 clamp(30px,3.3vw,46px)/1.35 var(--serif);letter-spacing:.055em}h2{font:500 25px/1.5 var(--serif)}h3{font-size:16px;font-weight:600}small,.muted{color:var(--muted)}[hidden]{display:none!important}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.skip{position:fixed;top:-80px;left:20px;background:var(--surface);z-index:100;padding:12px}.skip:focus{top:12px}.shell{display:grid;grid-template-columns:224px minmax(0,1fr);min-height:100vh}.sidebar{height:100vh;position:sticky;top:0;border-right:1px solid var(--line);padding:40px 25px 28px;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:13px}.seal{font:20px/1.15 var(--serif);color:var(--red);border:1px solid var(--red);padding:6px 7px;letter-spacing:2px;writing-mode:vertical-rl}.brand-name{font:500 23px var(--serif);letter-spacing:.12em}.eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}.brand .eyebrow{margin-top:8px;font-size:9px;letter-spacing:.13em}.nav{display:grid;gap:10px;margin-top:58px}.nav button{display:flex;align-items:center;gap:16px;text-align:left;background:transparent;padding:13px 15px;border-radius:5px;min-height:48px;color:var(--muted)}.nav button[aria-current=page]{background:var(--green);color:var(--surface)}.nav-num{font:italic 14px var(--serif);opacity:.8}.sidebar-bottom{margin-top:auto;padding-top:60px}.side-quote{font:17px/2.1 var(--serif);margin:32px 0;color:var(--muted)}.progress-track{height:3px;background:var(--line);margin:12px 0}.progress-fill{height:100%;background:var(--green);width:0}.progress-copy{display:flex;justify-content:space-between;font-size:12px}.local-label{font-size:11px;color:var(--muted);margin-top:12px}.main{padding:38px clamp(22px,4.5vw,74px) 48px;min-width:0;max-width:1510px;width:100%;margin:0 auto}.topline{display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line);padding-bottom:19px;margin-bottom:32px}.topline span{font-size:12px;letter-spacing:.12em}.topline .edition{color:var(--red);letter-spacing:.06em}.page-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:28px}.page-heading p{margin-top:12px;color:var(--muted);font-size:14px}.little-action{background:none;color:var(--green);text-decoration:underline;text-underline-offset:5px;font-size:13px;padding:10px;white-space:nowrap}.study-tools{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:20px;flex-wrap:wrap}.field-inline{display:flex;align-items:center;gap:10px;font-size:13px}.field-inline select,.select,input[type=search]{border:1px solid var(--line);background:var(--surface);border-radius:4px;padding:9px 12px;min-height:44px;max-width:100%}.field-inline select{background:transparent}.check{display:flex;align-items:center;gap:7px;min-height:44px;font-size:13px;cursor:pointer}.check input{accent-color:var(--green);width:16px;height:16px}.study-board{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);background:var(--surface);border:1px solid var(--line);border-radius:6px;overflow:hidden}.reading-panel{padding:30px clamp(22px,3.6vw,54px);position:relative}.poem-meta{display:flex;align-items:center;gap:13px;font-size:12px;color:var(--muted)}.poem-number{font:italic 26px var(--serif);color:var(--red)}.jp-lines{margin:24px 0 28px;display:grid;gap:13px}.jp-line{display:block;font:500 clamp(22px,2.2vw,30px)/1.6 var(--serif);letter-spacing:.07em}.reading{display:block;font:11px/1.8 var(--sans);color:var(--muted);letter-spacing:.1em;margin-bottom:1px}.kimariji-line{display:flex;align-items:center;gap:12px;font-size:12px;color:var(--muted);margin:16px 0}.kimariji{font:500 24px var(--serif);color:var(--red);border-bottom:2px solid #c88b75;padding:0 4px 3px;letter-spacing:.08em}.sound-button{display:inline-flex;gap:8px;align-items:center;border:1px solid var(--line);border-radius:4px;background:transparent;padding:8px 12px;min-height:42px;font-size:12px}.sound-icon{font-size:16px}.taking-panel{background:var(--soft);padding:25px 20px;display:flex;flex-direction:column;align-items:center;justify-content:center;border-left:1px solid var(--line);position:relative}.panel-label{color:var(--muted);font-size:11px;letter-spacing:.14em;margin-bottom:16px}.karuta{background:var(--surface);border:5px solid #587155;outline:1px solid #9ca58f;outline-offset:-8px;border-radius:1px;width:148px;height:218px;display:flex;justify-content:center;align-items:center;box-shadow:4px 6px 0 #344e4010;position:relative}.card-text{writing-mode:vertical-rl;text-orientation:upright;font:500 23px/1.75 var(--serif);letter-spacing:.055em;height:155px;display:flex;flex-direction:column}.card-column{display:block;white-space:nowrap}.card-hidden{font:19px/1.9 var(--serif);letter-spacing:.17em;writing-mode:vertical-rl;color:var(--muted)}.hint-under{font-size:11px;color:var(--muted);margin-top:17px;text-align:center}.study-actions{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px;flex-wrap:wrap}.btn{white-space:nowrap;border:1px solid var(--line);background:transparent;border-radius:4px;padding:10px 17px;min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none}.btn.primary{background:var(--green);border-color:var(--green);color:var(--surface)}.btn.small{font-size:12px;padding:7px 11px;min-height:40px}.btn[aria-pressed=true]{color:var(--red);border-color:var(--red);background:var(--redsoft)}.action-group{display:flex;gap:9px;align-items:center}.paging{display:flex;gap:8px;align-items:center;font-size:12px;color:var(--muted)}.arrow{width:42px;height:42px;border:1px solid var(--line);border-radius:4px;background:transparent;font-size:18px}.explanation{margin-top:23px;border-top:1px solid var(--line);padding-top:22px;display:grid;grid-template-columns:1fr 1fr;gap:28px}.explanation h3{font-size:12px;color:var(--muted);font-weight:400;margin-bottom:7px}.explanation p{font:17px/1.9 var(--serif)}.explanation .lower-reading{font:13px/1.9 var(--sans);letter-spacing:.05em}.study-strip{margin-top:28px}.section-label{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;font-size:12px;color:var(--muted)}.starter-chips{display:flex;flex-wrap:wrap;gap:9px}.starter-chip{width:48px;height:48px;border:1px solid var(--line);border-radius:3px;background:none;font:22px var(--serif);position:relative}.starter-chip[aria-pressed=true]{background:var(--green);color:var(--surface);border-color:var(--green)}.starter-chip.learned:after{content:"";position:absolute;bottom:5px;left:50%;width:4px;height:4px;border-radius:50%;background:var(--red)}.study-strip-note{font-size:12px;color:var(--muted);margin-top:12px}.notice{font-size:12px;margin-top:16px;color:var(--muted)}.empty{padding:46px 18px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:5px}.empty p{margin-bottom:16px}.filter-bar{display:grid;grid-template-columns:minmax(180px,1fr) 155px 155px;gap:12px;margin-bottom:14px}.filter-bar label{display:grid;gap:6px;font-size:12px;color:var(--muted)}.search-count{font-size:12px;color:var(--muted);margin-bottom:16px}.catalog{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 28px}.poem-item{background:none;border-top:1px solid var(--line);text-align:left;width:100%;padding:18px 0;display:grid;grid-template-columns:33px minmax(0,1fr) 24px;gap:12px;align-items:start}.poem-item:hover{background:#e7ebdf60}.item-number{font:italic 17px var(--serif);color:var(--muted);margin-top:4px}.item-title{font:20px var(--serif);letter-spacing:.035em;display:block;margin-bottom:7px}.item-meta{font-size:11px;color:var(--muted);display:flex;align-items:center;flex-wrap:wrap;gap:9px}.item-key{color:var(--red)}.item-status{font-size:12px;color:var(--green);padding-top:4px}.practice-config{background:var(--surface);border:1px solid var(--line);border-radius:5px;padding:26px;display:grid;grid-template-columns:1fr 1fr;gap:24px}.config-field{display:grid;gap:8px;font-size:13px}.practice-config .start-row{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:8px}.practice-intro{margin-top:30px;border-top:1px solid var(--line);padding-top:25px;display:grid;grid-template-columns:repeat(3,1fr);gap:25px}.practice-intro strong{font:25px var(--serif);color:var(--red);display:block;margin-bottom:9px}.practice-intro p{font-size:13px;color:var(--muted)}.quiz-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;font-size:13px}.quiz-prompt{background:var(--surface);border:1px solid var(--line);border-radius:5px;padding:25px;text-align:center;min-height:170px;display:flex;flex-direction:column;justify-content:center;align-items:center}.quiz-prompt .prompt-text{font:25px/1.9 var(--serif);margin:12px 0;white-space:pre-line}.quiz-prompt .prompt-key{font-size:44px;letter-spacing:.18em}.answers{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:23px 0}.answer{border:1px solid var(--line);border-radius:5px;padding:16px 10px;background:transparent;display:flex;align-items:center;flex-direction:column;gap:12px;transition:background .15s}.answer .karuta{width:116px;height:174px;border-width:4px;box-shadow:none}.answer .card-text{height:130px;font-size:19px;line-height:1.7}.answer .answer-label{font-size:11px;color:var(--muted);min-height:18px}.answer.correct{background:#dce7d9;border:2px solid var(--green);padding:15px 9px}.answer.incorrect{background:var(--redsoft);border:2px solid var(--red);padding:15px 9px}.answer:disabled{opacity:1}.feedback{border-left:3px solid var(--green);padding:13px 18px;background:var(--soft);margin-bottom:18px}.feedback.error{border-color:var(--red);background:var(--redsoft)}.feedback strong{display:block;margin-bottom:5px}.feedback p{font-size:13px}.quiz-footer{display:flex;justify-content:space-between;align-items:center;gap:12px}.result{padding:32px;background:var(--surface);border:1px solid var(--line);border-radius:5px;text-align:center}.result-score{font:64px var(--serif);color:var(--green);margin:12px}.result-actions{display:flex;justify-content:center;gap:12px;margin-top:25px;flex-wrap:wrap}.wrong-list{margin-top:20px;text-align:left}.wrong-list button{display:flex;justify-content:space-between;width:100%;padding:14px 0;background:none;border-top:1px solid var(--line);gap:14px}.rule-lead{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;padding:26px;background:var(--surface);border:1px solid var(--line);margin-bottom:24px;border-radius:5px}.rule-lead p{font-size:14px;color:var(--muted);margin-top:10px}.syllables{display:flex;align-items:center;justify-content:center;gap:9px;flex-wrap:wrap}.syllables span{display:grid;text-align:center;gap:8px;font-size:12px;color:var(--muted)}.syllables b{font:36px var(--serif);color:var(--green)}.syllables .lower b{color:var(--red)}.rules details{border-top:1px solid var(--line);padding:0 0 6px}.rules summary{cursor:pointer;padding:18px 0;font-size:16px}.rules .rule-content{padding:0 0 18px;max-width:780px;font-size:14px;line-height:1.95;color:var(--muted)}.rule-content p+p{margin-top:12px}.rule-content strong{color:var(--ink);font-weight:500}.rule-content ul{padding-left:20px}.comparison{display:flex;gap:14px;flex-wrap:wrap;margin:17px 0}.comparison .example{padding:13px 17px;background:var(--soft);border-radius:3px;font:23px var(--serif)}.example em{font-style:normal;color:var(--red)}.source-list{padding-left:19px}.source-list li{margin:10px 0}.bottom-note{font-size:11px;color:var(--muted);margin-top:40px;padding-top:16px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:14px}.bottom-note button{font-size:11px;background:none;color:var(--muted);text-decoration:underline;padding:0}.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);max-width:calc(100vw - 32px);background:var(--ink);color:var(--surface);padding:11px 19px;border-radius:5px;box-shadow:0 4px 20px #0002;font-size:13px;z-index:20;pointer-events:none}.storage-warning{color:var(--red);background:var(--redsoft);padding:10px 15px;margin-bottom:15px;font-size:12px}.footnote-link{font-size:12px}.no-kana .reading{display:none}.page-view{animation:enter .17s ease-out}@keyframes enter{from{opacity:.65;transform:translateY(4px)}to{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@media(min-width:1550px){.main{padding-left:80px;padding-right:80px}.study-board{min-height:395px}.jp-lines{gap:20px}.karuta{width:166px;height:243px}.card-text{font-size:26px;height:173px}}
@media(max-width:1120px){.shell{grid-template-columns:186px 1fr}.sidebar{padding:30px 17px}.brand-name{font-size:20px}.main{padding:28px 28px 40px}.answers{gap:9px}.answer{padding:13px 4px}.answer .karuta{width:98px;height:160px}.answer .card-text{font-size:17px;height:115px}.answer.correct,.answer.incorrect{padding:12px 3px}.reading-panel{padding:24px}.filter-bar{grid-template-columns:1fr 135px 135px}}
@media(max-width:800px){.shell{display:block}.sidebar{height:auto;position:static;padding:18px 22px;border-right:0;border-bottom:1px solid var(--line);display:flex;flex-direction:row;align-items:center;justify-content:space-between}.brand{gap:10px}.brand-name{font-size:21px}.brand .eyebrow{margin-top:4px}.seal{font-size:15px;padding:4px}.sidebar-bottom{margin:0;padding:0;min-width:110px}.side-quote,.local-label{display:none}.progress-copy{font-size:10px;gap:10px}.progress-track{margin:8px 0}.nav{position:fixed;bottom:0;left:0;right:0;margin:0;display:grid;grid-template-columns:repeat(4,1fr);gap:0;background:var(--paper);border-top:1px solid var(--line);padding:6px 8px calc(6px + env(safe-area-inset-bottom));z-index:10}.nav button{display:flex;justify-content:center;padding:10px 6px;gap:8px;font-size:12px;min-height:46px}.nav-num{font-size:12px}.main{padding:24px 22px 105px}.topline{margin-bottom:25px;padding-bottom:14px}.topline span{font-size:10px}.page-heading{margin-bottom:23px}.page-heading p{font-size:12px;max-width:250px}h1{font-size:32px}.toast{bottom:86px}.filter-bar{grid-template-columns:1fr 1fr}.filter-bar label:first-child{grid-column:1/-1}.answer .karuta{width:116px;height:175px}.answer .card-text{height:130px;font-size:19px}.answers{gap:12px}.bottom-note{margin-top:30px}}
@media(max-width:540px){.main{padding:22px 18px 100px}.page-heading{gap:10px;display:block}.page-heading>.little-action{display:none}.little-action{font-size:11px;padding:7px 0}.topline .edition{letter-spacing:0}.study-board{grid-template-columns:1.12fr 1fr}.reading-panel{padding:20px 15px}.poem-meta{gap:8px;font-size:10px}.poem-number{font-size:21px}.jp-lines{gap:13px;margin:20px 0}.jp-line{font-size:19px;letter-spacing:.025em;white-space:nowrap}.reading{font-size:9px;letter-spacing:0}.kimariji-line{gap:8px;flex-wrap:wrap;font-size:10px;margin:8px 0}.kimariji{font-size:21px}.sound-button{padding:7px;font-size:10px;gap:4px}.taking-panel{padding:18px 8px}.karuta{width:112px;height:176px}.card-text{font-size:19px;height:130px;line-height:1.65}.card-hidden{font-size:16px}.panel-label{font-size:10px;margin-bottom:13px}.hint-under{font-size:9px;margin-top:12px}.study-actions{gap:12px}.action-group{flex:1}.action-group .btn{padding:9px 10px;font-size:12px;flex:1}.paging{gap:7px}.explanation{grid-template-columns:1fr;gap:18px}.explanation p{font-size:16px}.catalog{grid-template-columns:1fr}.starter-chips{gap:6px}.starter-chip{width:calc((100% - 36px)/7);max-width:48px;height:45px}.study-tools{margin-bottom:14px}.field-inline{font-size:12px;gap:8px}.field-inline select{max-width:169px;font-size:12px;padding:8px}.check{font-size:11px}.practice-config{padding:20px;grid-template-columns:1fr;gap:18px}.practice-config .start-row{align-items:stretch;flex-direction:column}.practice-intro{gap:16px}.practice-intro strong{font-size:21px}.practice-intro p{font-size:11px}.answers{grid-template-columns:repeat(2,1fr)}.answer .karuta{width:111px;height:162px}.answer .card-text{height:119px;font-size:18px}.answer{gap:8px;padding:13px 6px}.answer.correct,.answer.incorrect{padding:12px 5px}.quiz-prompt{min-height:150px;padding:19px}.quiz-prompt .prompt-text{font-size:23px}.quiz-prompt .prompt-key{font-size:35px}.rule-lead{grid-template-columns:1fr;padding:22px;gap:20px}.rule-lead h2{font-size:22px}.result{padding:24px 18px}.result-score{font-size:52px}.bottom-note{font-size:10px}.topline{gap:8px}.edition{white-space:nowrap}.nav button{font-size:12px;gap:6px}.sidebar{padding:16px 18px}.brand-name{font-size:20px}.brand .eyebrow{font-size:8px}.sidebar-bottom{min-width:94px}}
@media(max-width:540px){.is-quizzing .topline{display:none}.is-quizzing #practice .page-heading{margin-bottom:14px}.is-quizzing #practice .page-heading h1{font-size:26px}.is-quizzing #practice .page-heading p{display:none}.is-quizzing .quiz-head{margin-bottom:12px}.is-quizzing .quiz-prompt{min-height:108px;padding:12px}.is-quizzing .quiz-prompt .prompt-text{margin:7px 0}.is-quizzing .quiz-prompt .prompt-key{font-size:30px}.is-quizzing .answers{margin:16px 0;gap:10px}.is-quizzing .answer{padding:10px 6px;gap:6px}.is-quizzing .answer .karuta{height:143px;width:102px}.is-quizzing .answer .card-text{height:105px;font-size:16px}.is-quizzing .answer.correct,.is-quizzing .answer.incorrect{padding:9px 5px}}
@media(max-width:360px){.main{padding-left:12px;padding-right:12px}.reading-panel{padding:17px 12px}.jp-line{font-size:17px}.taking-panel{padding-left:5px;padding-right:5px}.karuta{width:102px}.card-text{font-size:17px;line-height:1.5;height:117px}.page-heading p{max-width:225px}.little-action{display:none}.action-group{width:100%;flex-basis:100%}.paging{margin-left:auto}.brand-name{font-size:18px}.sidebar{padding:14px 12px}}

/* Traditional vertical card typography. */
h1{font-family:var(--sans);font-size:28px;letter-spacing:0;font-weight:500}.brand-name{font-size:21px}.page-heading{margin-bottom:22px}.side-quote{font-size:15px}
.reading-panel{display:flex;flex-direction:column;align-items:center;padding:24px}.poem-meta{align-self:stretch}.jp-lines{display:flex;flex-direction:column;align-items:center;gap:14px;margin:18px 0}.reading-card{width:202px;height:298px;border:6px solid #466247;background:#fffdf7;box-shadow:2px 4px 8px #29342e12;display:flex;flex-direction:row-reverse;justify-content:center;gap:15px;padding:22px 15px}.reading-card .jp-line{writing-mode:vertical-rl;text-orientation:upright;white-space:nowrap;font:500 28px/1.2 var(--serif);letter-spacing:.11em;margin:0}.reading-aid{font:12px/1.8 var(--sans);color:var(--muted);max-width:280px;text-align:center;letter-spacing:0}.kimariji-line{margin:0 0 13px}.taking-panel{background:#e7ebdf}.karuta{border-color:#466247;background:#fffdf7;box-shadow:2px 4px 8px #29342e12;outline:none}.card-text{font-family:var(--serif);font-weight:500}.no-kana .reading-aid{display:none}
@media(max-width:540px){.reading-panel{padding:18px 10px}.poem-meta{font-size:10px;gap:7px}.jp-lines{margin:15px 0;gap:12px}.reading-card{width:139px;height:220px;padding:17px 10px;border-width:4px;gap:9px}.reading-card .jp-line{font-size:20px;letter-spacing:.09em}.reading-aid{font-size:10px;max-width:145px}.kimariji-line{justify-content:center}.taking-panel .karuta{width:129px;height:200px}.taking-panel .card-text{font-size:22px;line-height:1.6;height:153px}.taking-panel{padding:18px 8px}h1{font-size:26px}}
@media(max-width:360px){.reading-card{width:122px;height:208px;gap:7px;padding:16px 8px}.reading-card .jp-line{font-size:18px}.taking-panel .karuta{width:112px;height:178px}.taking-panel .card-text{font-size:19px;line-height:1.5;height:134px}}
</style>
</head>
